---
import { build, chapters, pageHref } from '../../../../book.config.mjs';
import Base from '../../../layouts/Base.astro';
import { contents } from '../../../lib/contents.ts';
import { renderMarkdown } from '../../../lib/render.ts';

export function getStaticPaths() {
	return [{ params: { version: build.version } }];
}

const book = contents();
const introduction = await renderMarkdown(book.introduction, `${chapters}/README.md`);
---

<Base
	title="Contents"
	description={`The contents of The Snapfit Book (${build.version}): every part and chapter in reading order.`}
	edition={{ page: '' }}
>
	<div class="toc">
		<p class="eyebrow">Edition {build.version}</p>
		<h1>Contents</h1>
		<div class="prose" set:html={introduction} />
		{
			book.parts.map((part) => {
				const numbered = part.pages.filter((page) => page.number !== undefined);
				const others = part.pages.filter((page) => page.number === undefined);
				return (
					<section aria-labelledby={part.id}>
						<h2 id={part.id}>{part.title}</h2>
						{numbered.length > 0 && (
							<ol start={numbered[0].number}>
								{numbered.map((page) => (
									<li>
										<a href={pageHref(page.slug)}>{page.label}</a>
									</li>
								))}
							</ol>
						)}
						{others.length > 0 && (
							<ul role="list">
								{others.map((page) => (
									<li>
										<a href={pageHref(page.slug)}>
											{page.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})
		}
	</div>
</Base>
